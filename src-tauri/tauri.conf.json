{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OTS Manager",
  "version": "0.1.0",
  "identifier": "com.farsightbs.otsmanager",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OTS Manager",
        "width": 1150,
        "height": 740,
        "minWidth": 780,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "OpenTimestamps Manager",
    "longDescription": "Create, upgrade and verify OpenTimestamps (.ots) proofs in bulk.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
